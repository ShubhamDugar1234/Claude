# ---------------------------------------------------------------------------
# MV Dugar AI Portal settings. Copy this file to `.env` and fill in the values.
# Never commit `.env` and never share it: it holds secret keys.
# This is the M0 skeleton; later milestones add mail, auth and Anthropic settings,
# and the README explains every line.
# ---------------------------------------------------------------------------

# Address of the PostgreSQL database.
# Development (docker-compose.dev.yml): postgresql://portal:portal@localhost:5432/portal
DATABASE_URL="postgresql://portal:portal@localhost:5432/portal"

# Public web address of the portal, without a trailing slash, e.g. https://ai.mvdugar.com
APP_URL="http://localhost:3000"

# --- Limits ---
# Monthly allowance for newly added staff, in USD. Admins can change each person's cap later.
DEFAULT_USER_CAP_USD="10"

# Day of the month (1-28) when allowances and budgets reset, at 00:00 UTC (05:45 in Nepal).
# Keep 1 so the portal's months line up with Anthropic's bills.
BILLING_RESET_DAY="1"

# Most messages one person can send per minute.
RATE_LIMIT_PER_MINUTE="20"

# Most replies one person can have arriving at the same time.
MAX_CONCURRENT_STREAMS="2"

# Conversations older than this many days are deleted automatically. Usage records are kept.
RETENTION_DAYS="180"
