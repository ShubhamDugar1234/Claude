# =============================================================================
# MV Dugar AI Portal settings
# Copy this file to ".env" in the same folder and fill in the values.
# Never share .env or commit it to Git: it holds passwords and keys.
# The README explains each line in plain words.
# =============================================================================

# --- Web address ---
# The portal's address, without "https://" (used by Caddy to get the HTTPS certificate).
DOMAIN="ai.mvdugar.com"
# The same address with https:// and no slash at the end.
APP_URL="https://ai.mvdugar.com"
AUTH_URL="https://ai.mvdugar.com"

# --- Database ---
# Password for the portal's database. Use letters and numbers only. Generate one with:
#   openssl rand -hex 24
POSTGRES_PASSWORD=""
# Only for running the portal without Docker (development or Vercel). With docker-compose
# this is set automatically from POSTGRES_PASSWORD and this line is ignored.
DATABASE_URL="postgresql://portal:portal@localhost:5432/portal"

# --- Sign-in ---
# Long random secret that protects logins and sign-in codes. Generate one with:
#   openssl rand -base64 32
# Changing it signs everyone out.
AUTH_SECRET=""

# Company email domain. Only addresses ending in @<this domain> can sign in.
COMPANY_EMAIL_DOMAIN="mvdugar.com"

# Optional: individual non-company addresses that may also sign in, separated by commas.
# They still need to be added as users by an admin. Example: "auditor@gmail.com,consultant@example.com"
ALLOWED_EMAILS=""

# "true": anyone with a company address can sign in and waits in "Pending approval" until
# an admin assigns their business. "false": an admin must add each person first.
AUTO_PROVISION="false"

# The first super admin, created automatically on the first start.
SUPER_ADMIN_EMAIL="shubham@mvdugar.com"
SUPER_ADMIN_NAME="Shubham Dugar"

# Optional "Sign in with Google" button (only company Google accounts are accepted).
# Needs an OAuth client from Google Cloud Console: see the README.
ENABLE_GOOGLE_AUTH="false"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Email (sign-in codes are sent from the company mail server) ---
# Carbonio SMTP. Port 587 uses STARTTLS (recommended); 465 uses TLS.
SMTP_HOST="mail.mvdugar.com"
SMTP_PORT="587"
SMTP_USER="noreply@mvdugar.com"
SMTP_PASSWORD=""
# Sender name and address shown in the email.
MAIL_FROM="MV Dugar AI Portal <noreply@mvdugar.com>"
# Development only: "console" prints codes in the terminal instead of sending email.
# MAIL_TRANSPORT="console"

# --- Claude (Anthropic API) ---
# The default API key. Each business uses the key whose NAME is in its "API key setting"
# on the Businesses page (ANTHROPIC_API_KEY unless you change it). For a separate key per
# business, add lines like the example below and set that name on the business.
ANTHROPIC_API_KEY=""
# ANTHROPIC_API_KEY_MAHINDRA=""

# Development only: "true" uses a free fake Claude (no network, no cost). Never on a live server.
# MOCK_ANTHROPIC="true"

# --- Limits ---
# Monthly allowance for newly added staff, in USD. Admins can change each person's cap later.
DEFAULT_USER_CAP_USD="10"

# Day of the month (1-28) when allowances and budgets reset, at 00:00 UTC (05:45 in Nepal).
# Keep 1 so the portal's months line up with Anthropic's bills.
BILLING_RESET_DAY="1"

# Most messages one person can send per minute.
RATE_LIMIT_PER_MINUTE="20"

# Most replies one person can have arriving at the same time.
MAX_CONCURRENT_STREAMS="2"

# Conversations not used for this many days are deleted automatically (with their files).
# Usage records are kept for billing.
RETENTION_DAYS="180"

# --- Daily housekeeping job ---
# Secret the scheduler sends to run the daily job. At least 16 characters. Generate one with:
#   openssl rand -hex 24
CRON_SECRET=""
