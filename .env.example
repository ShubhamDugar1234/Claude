# ---------------------------------------------------------------------------
# MV Dugar AI Portal settings. Copy this file to `.env` and fill in the values.
# Never commit `.env` and never share it: it holds secret keys.
# This is the M0 skeleton; later milestones add mail, auth and Anthropic settings,
# and the README explains every line.
# ---------------------------------------------------------------------------

# Address of the PostgreSQL database.
# Development (docker-compose.dev.yml): postgresql://portal:portal@localhost:5432/portal
DATABASE_URL="postgresql://portal:portal@localhost:5432/portal"

# Public web address of the portal, without a trailing slash, e.g. https://ai.mvdugar.com
APP_URL="http://localhost:3000"
