# ---------------------------------------------------------------------------
# MV Dugar AI Portal settings. Copy this file to `.env` and fill in the values.
# Never commit `.env` and never share it: it holds secret keys.
# This is the M0 skeleton; later milestones add mail, auth and Anthropic settings,
# and the README explains every line.
# ---------------------------------------------------------------------------

# Address of the PostgreSQL database.
# Development (docker-compose.dev.yml): postgresql://portal:portal@localhost:5432/portal
DATABASE_URL="postgresql://portal:portal@localhost:5432/portal"

# Public web address of the portal, without a trailing slash, e.g. https://ai.mvdugar.com
APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# --- Sign-in ---
# Long random secret that protects sign-in sessions and codes. Generate one with:
#   openssl rand -base64 32
# Changing it signs everyone out.
AUTH_SECRET=""

# Company email domain. Only addresses ending in @<this domain> can sign in.
COMPANY_EMAIL_DOMAIN="mvdugar.com"

# Optional: individual non-company addresses that may also sign in, comma-separated.
# They still need to be added as users by an admin. Example: "auditor@gmail.com,consultant@example.com"
ALLOWED_EMAILS=""

# If "true", anyone with a company address can sign in and will wait in "Pending approval"
# until an admin assigns them a business. If "false", an admin must add each person first.
AUTO_PROVISION="false"

# The first super admin, created by `npm run db:seed`.
SUPER_ADMIN_EMAIL="shubham@mvdugar.com"
SUPER_ADMIN_NAME="Shubham Dugar"

# Optional "Sign in with Google" button. Only company Google accounts are accepted.
# Needs an OAuth client from Google Cloud Console (see README).
ENABLE_GOOGLE_AUTH="false"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Email (for sign-in codes) ---
# Company mail server (Carbonio). Port 587 uses STARTTLS; 465 uses TLS.
SMTP_HOST="mail.mvdugar.com"
SMTP_PORT="587"
SMTP_USER="noreply@mvdugar.com"
SMTP_PASSWORD=""
# Sender shown in the email.
MAIL_FROM="MV Dugar AI Portal <noreply@mvdugar.com>"
# "smtp" sends real email (the default in production). In development, "console" prints
# codes in the terminal instead (the default when not in production).
# MAIL_TRANSPORT="console"

# --- Limits ---
# Monthly allowance for newly added staff, in USD. Admins can change each person's cap later.
DEFAULT_USER_CAP_USD="10"

# Day of the month (1-28) when allowances and budgets reset, at 00:00 UTC (05:45 in Nepal).
# Keep 1 so the portal's months line up with Anthropic's bills.
BILLING_RESET_DAY="1"

# Most messages one person can send per minute.
RATE_LIMIT_PER_MINUTE="20"

# Most replies one person can have arriving at the same time.
MAX_CONCURRENT_STREAMS="2"

# Conversations older than this many days are deleted automatically. Usage records are kept.
RETENTION_DAYS="180"
